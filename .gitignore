# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local env / secrets (setup.sh writes generated credentials here)
.env
.env.*
!.env.example

# Runtime state this project generates outside of ~/.distill (shouldn't
# normally live in the repo, but ignore defensively in case something is
# run from here during local testing)
*.log
*.pid
/logs/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Downloaded/installed at setup time — never commit these
/dagu-bin/
*.tar.gz

# Build output / dependencies (also covered in web/.gitignore)
node_modules/
build/
.svelte-kit/

# Runtime env files (secrets live in ~/.distill/env and the launchd plists, never here)
env
*.env
secrets*

# Model weights, training outputs and job data (these live under ~/.distill)
results/
models/
adapters/
fused-model/
*.safetensors
*.gguf
*.npz
*.bin
*.tgz
/.distill/
